# Kairos — environment variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kairos:kairos@postgres:5432/kairos

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM ───────────────────────────────────────────────────────────────────────
# Provider: anthropic | openrouter | mock (auto-detects from keys when unset)
# Defaults to mock when no API key is set or MOCK_EXTERNAL_APIS=true.
LLM_PROVIDER=mock

# Direct Anthropic (when LLM_PROVIDER=anthropic or auto with this key set)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter (when LLM_PROVIDER=openrouter or auto with only this key set)
# Get a key at https://openrouter.ai/keys — paste it here:
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-32-char-string
TELEGRAM_WEBHOOK_URL=https://your-domain.com/bot/webhook

# ngrok (optional — for Telegram webhook local dev)
# Get token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-random-32-char-string
JWT_EXPIRY_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Force mock providers (no Telegram/Google/Anthropic calls). Default true for local dev.
MOCK_EXTERNAL_APIS=true

# ── External APIs ─────────────────────────────────────────────────────────────
# Open-Meteo is free and requires no API key — no variable needed
# Add here if switching to a paid weather provider:
# WEATHER_API_KEY=
