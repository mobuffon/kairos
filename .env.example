# Kairos — environment variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kairos:kairos@postgres:5432/kairos

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-32-char-string
TELEGRAM_WEBHOOK_URL=https://your-domain.com/bot/webhook

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-random-32-char-string
JWT_EXPIRY_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Force mock providers (no Telegram/Google/Anthropic calls). Default true for local dev.
MOCK_EXTERNAL_APIS=true

# ── External APIs ─────────────────────────────────────────────────────────────
# Open-Meteo is free and requires no API key — no variable needed
# Add here if switching to a paid weather provider:
# WEATHER_API_KEY=
